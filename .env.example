# Verdex env — copy to .env.local (never commit real keys)
# CoinMarketCap API key (Basic tier works; Startup unlocks more endpoints; comma-separated supported)
CMC_API_KEY=
# Fallback CoinMarketCap API key (used if primary key runs out of credits, hits rate limits, or fails)
CMC_FALLBACK_API_KEY=

# TypeSafe AI Jev key(s) — comma-separated pool, rotates on failure
TYPESAFE_API_KEYS=

# Optional LLM narrator (Groq free tier). If empty, deterministic template narrator is used.
GROQ_API_KEY=

# Set to "1" to allow live API calls from the UI (demo mode = committed snapshots only)
VERDEX_LIVE=
